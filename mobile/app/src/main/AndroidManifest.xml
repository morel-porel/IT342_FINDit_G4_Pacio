<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="true"
        android:label="FINDit"
        android:supportsRtl="true"
        android:theme="@style/Theme.AppCompat.Light.NoActionBar"
        android:usesCleartextTraffic="true" >


        <activity
            android:name=".feature.auth.LoginActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>

        <activity android:name=".feature.auth.RegisterActivity" android:exported="false"/>
        <activity android:name=".feature.dashboard.DashboardActivity" android:exported="false"/>
        <activity android:name=".feature.item.ItemDetailActivity"
                android:parentActivityName=".MainActivity" />

        <activity android:name=".feature.profile.ProfileActivity"
                android:parentActivityName=".MainActivity" />
        <activity android:name=".feature.item.ReportItemActivity"
                android:parentActivityName=".MainActivity" />

        <activity android:name=".feature.claim.ClaimSubmissionActivity"
                android:parentActivityName=".feature.item.ItemDetailActivity" />
        <activity android:name=".feature.myclaims.MyClaimsActivity" android:exported="false"/>
        <activity android:name=".feature.myreports.MyReportsActivity" android:exported="false"/>
    </application>

</manifest>