<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="#FFFFFF">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Mark as Resolved?"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="#0F172A"
        android:layout_marginBottom="6dp"/>

    <TextView
        android:id="@+id/tvResolveItemName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Item Name"
        android:textSize="14sp"
        android:textColor="#334155"
        android:layout_marginBottom="8dp"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="This will mark the item as resolved. This action cannot be undone."
        android:textSize="13sp"
        android:textColor="#94A3B8"
        android:layout_marginBottom="24dp"/>

    <Button
        android:id="@+id/btnConfirmResolve"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:text="Yes, Mark as Resolved"
        android:textColor="#FFFFFF"
        android:backgroundTint="#16A34A"
        android:textStyle="bold"
        android:layout_marginBottom="10dp"/>

    <Button
        android:id="@+id/btnCancelResolve"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:text="Cancel"
        android:backgroundTint="#E2E8F0"
        android:textColor="#334155"
        android:textStyle="bold"/>

</LinearLayout>
